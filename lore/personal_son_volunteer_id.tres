script = ExtResource("1_entry")
id = "personal_son_volunteer_id"
title = "Volunteer 14 ID Card"
type = 3
text = "VOLUNTEER IDENTIFICATION, PROJECT IRONWOOD\nVolunteer No. 14\nStatus stamped in red: TRANSFERRED - PROGRAM ZERO\n\nThe photo on the card has been torn off."
