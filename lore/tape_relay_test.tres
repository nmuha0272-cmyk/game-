[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/lore/lore_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = "tape_relay_test"
title = "Reel Tape: Relay Test"
type = 1
text = "TECH: Relay test, Level B to surface. Testing, testing.\nSURFACE: Read you, Level B. Loud and clear.\nTECH: Copy. Frequency's drifting again. I'll call it out, you match it.\nSURFACE: Hang on. Level B, who else is on this line?\nTECH: Nobody. Just me.\nSURFACE: Then who's breathing?\n(Four slow taps on the microphone. The tape ends.)"
owner_character = -1
voice_line = ""
