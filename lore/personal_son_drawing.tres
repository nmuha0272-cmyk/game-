[resource]
script = ExtResource("1_entry")
id = "personal_son_drawing"
title = "Crayon Drawing"
type = 3
text = "A child's crayon drawing taped inside a locker: two stick figures in uniforms, one in a lab coat, holding hands with a smaller stick figure between them.
Written at the bottom, in shaky child's handwriting: COME HOME SOON MOM AND DAD - LOVE ELI."
owner_character = 0
voice_line = "I drew this. I mailed it to them. They kept it... they kept it down here."