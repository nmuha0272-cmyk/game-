[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/lore/lore_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = "file_radio_log"
title = "Radio Room Log"
type = 0
text = "EMERGENCY BROADCAST - LEVEL B\nThe dormitory door code is broadcast on a loop on the emergency frequency, in case the staff lose their badges.\nThe frequency is posted on the chart in the signal booth. It DRIFTS. Read it out while someone tunes.\nIf you can hear this, you are already too far down."
owner_character = -1
voice_line = ""
