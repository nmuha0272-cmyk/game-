[resource]
script = ExtResource("1_entry")
id = "file_power_manual"
title = "Power Room: Restart Procedure"
type = 0
text = "EMERGENCY POWER RESTART\n1. Pour the fuel into the generator tank (a spare can is on the stairwell landing). The generator starts by itself.\n2. Set the 3 main breakers to match the WIRING DIAGRAM on the wall beside them.\n3. The security shutter to the lower tunnels opens when power is back."
owner_character = -1
voice_line = ""
