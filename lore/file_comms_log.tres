[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/lore/lore_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = "file_comms_log"
title = "Comms Room Duty Log"
type = 0
text = "LEVEL B COMMUNICATIONS - DUTY LOG\n\nThe elevator override has to be AUTHORISED by the surface relay. No relay, no override. That was the whole point: nobody comes up unless the surface says so.\n\nThe relay listens on the emergency band. The band DRIFTS (cheap crystals). Somebody reads the live frequency off the antenna room chart and calls it out; somebody else tunes.\n\nLast entry, 03:12: Surface is not answering. Surface is LISTENING. I can hear them breathing on the line."
owner_character = -1
voice_line = ""
