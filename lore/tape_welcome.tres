[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/lore/lore_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = "tape_welcome"
title = "Reel Tape 1: Welcome, Volunteers"
type = 1
text = "DIRECTOR CALLOWAY: Good morning, volunteers, and welcome to Site 12.\nDIRECTOR CALLOWAY: What you do here will make this nation stronger than any other.\nDIRECTOR CALLOWAY: You will receive a simple course of vitamins. Nothing more.\nDIRECTOR CALLOWAY: Report any... changes to the medical staff at once.\nDIRECTOR CALLOWAY: Remember your volunteer number. You will need it at the lower doors.\n(The tape clicks. Someone breathes very close to the microphone.)"
owner_character = -1
voice_line = ""
