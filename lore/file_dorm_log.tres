[ext_resource type="Script" path="res://scripts/lore/lore_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = "file_dorm_log"
title = "Billeting Log - West Dorm"
type = 0
text = "WEST DORM - LEVEL B\nEight bunks. Twelve men on rotation. Nobody has slept here in sixteen years.\n\nMAINTENANCE NOTE: The dorm runs on its own AUX breaker bank. Whenever the main grid is reset the aux bank trips. The new switch sequence is pinned up on the bunk-room wall. If the dorm is dark, the elevator consoles will NOT accept an override.\n\n- D. KESSLER, FACILITIES"
owner_character = -1
voice_line = ""
