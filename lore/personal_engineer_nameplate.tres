[resource]
script = ExtResource("1_entry")
id = "personal_engineer_nameplate"
title = "Desk Nameplate and Mug"
type = 3
text = "A brass nameplate, worn smooth: CHIEF ENGINEER, GROWTH CHAMBER.\nNext to it, a chipped coffee mug, still sitting where it was left decades ago."
owner_character = 2
voice_line = "That's... my desk. They never even moved my mug."
