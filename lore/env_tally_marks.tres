[resource]
script = ExtResource("1_entry")
id = "env_tally_marks"
title = "Tally Marks"
type = 0
text = "Hundreds of tally marks scratched into the concrete wall of the stairwell.\nThey go on for floors. Someone was counting the days.\n\nNear the bottom, in a different hand:\nTHEY'RE STILL ALIVE IN THERE."
owner_character = -1
voice_line = ""