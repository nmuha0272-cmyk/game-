[node name="ArticleText" type="RichTextLabel" parent="NewspaperContainer/Newspaper/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 380)
layout_mode = 2
theme_override_colors/default_color = Color(0.1, 0.1, 0.1, 1)
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "BLACKWATER COUNTY — Two college students have become the sixth and seventh people to vanish near the abandoned Blackwater Weather Station this year.

[b]Marcus Bell, 21, and Jenna Park, 20[/b], told friends they were going to film \"the creepiest place in the state\" for their channel. Their car was found Saturday at the end of the access road, keys still in the ignition.

They join five others missing since August, including reporter [b]Daniel Marsh[/b], who had been investigating the station's past.

The weather station was closed in 1999 after what officials called a gas leak. Eleven staff members died that night, including a married couple, Dr. Maria Reyes and Sgt. Daniel Reyes.

\"There is nothing out there but an empty building,\" a county spokesperson said. Search teams have not been allowed past the fence.

[i]Continued on page A4...[/i]"
fit_content = true
scroll_active = false

