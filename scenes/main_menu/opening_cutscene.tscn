text = "That night..."
horizontal_alignment = 1

[node name="Text" type="RichTextLabel" parent="HospitalContainer/VBoxContainer"]
custom_minimum_size = Vector2(800, 400)
layout_mode = 2
theme_override_colors/default_color = Color(0.85, 0.82, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[center]Eli Reyes read the article three times.

He was five years old in 1999, when his mom and dad drove to work at the weather station and never came home. \"A gas leak,\" they told him. Closed caskets.

Now Marcus and Jenna, his two best friends, had gone out there. For him. To find out what really happened to his parents.

And they had not come back.

Cole Brennan, the soldier who took Eli in when his parents died and raised him like his own son, said no. Then he said he was coming too.

Nora Vance, a reporter, had lost her source out there.

Walter Kessler said he used to work at the station. He said he knew the way in.

[i]Seven people are missing. Four are going in after them.[/i][/center]"
fit_content = true
scroll_active = false

