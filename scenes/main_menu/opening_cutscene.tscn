text = "Six months earlier..."
horizontal_alignment = 1

[node name="Text" type="RichTextLabel" parent="HospitalContainer/VBoxContainer"]
custom_minimum_size = Vector2(800, 400)
layout_mode = 2
theme_override_colors/default_color = Color(0.85, 0.82, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[center]The hospital room was quiet except for the beeping monitors.

Eli sat beside his father's bed, watching the man who had always seemed so strong waste away.

\"It's not cancer, son,\" David Chen whispered, his voice thin. \"They told us it was vitamins. Strength supplements for soldiers. But it was something else.\"

His father's hand trembled as he pulled out an old dog tag from beneath his hospital gown.

\"VOLUNTEER 14 - IRONWOOD\"

\"They're all dying now. Everyone from the program. One by one.\" His father's eyes met Eli's. \"Stay away from that place. The old weather station. Promise me.\"

But Eli couldn't promise that.

Not when seventeen men had died.
Not when the government claimed ignorance.
Not when his father deserved the truth.

[i]Three days later, David Chen was gone.[/i][/center]"
fit_content = true
scroll_active = false

