[node name="ArticleText" type="RichTextLabel" parent="NewspaperContainer/Newspaper/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 380)
layout_mode = 2
theme_override_colors/default_color = Color(0.1, 0.1, 0.1, 1)
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "PORTLAND — Another former military volunteer has died under mysterious circumstances, bringing the total to seventeen deaths in the past six months.

[b]David Chen, 54[/b], passed away last Thursday after a brief battle with what doctors initially diagnosed as an aggressive form of bone cancer. However, medical examiners are now questioning that diagnosis.

\"The cell degradation patterns don't match any known cancer,\" said Dr. Sarah Mitchell, who reviewed the autopsy. \"It's almost as if his body was rejecting itself from the inside out.\"

Chen is the latest in a growing list of former servicemen who participated in a classified military program in the 1960s. All victims displayed similar symptoms: unexplained bone density changes, organ failure, and rapid deterioration.

Family members report that in his final days, Chen spoke repeatedly about \"Project IRONWOOD\" and urged his son to \"stay away from the old weather station.\"

The Department of Defense declined to comment on the nature of Chen's service or the existence of any program by that name.

[i]Continued on page A4...[/i]"
fit_content = true
scroll_active = false

